            },
            "props": {
              "alignItems": "center",
              "justify": "center"
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "McName_0"
            },
            "position": {
              "basis": "32.8%"
            },
            "props": {
              "style": {
                "classes": "Header/Page/Datail"
