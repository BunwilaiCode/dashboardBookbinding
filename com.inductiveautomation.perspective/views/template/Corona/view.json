{
  "custom": {},
  "params": {
    "detail": "Brochure",
    "status": "normal",
    "title": "Book type"
  },
  "propConfig": {
    "params.detail": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.status": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 72,
      "width": 152
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.title}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "PerfectBinder/Title"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "light"
        },
        "position": {
          "basis": "15px"
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.status"
              },
              "transforms": [
                {
                  "fallback": "#000000",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "normal",
                      "output": "#2DD4BF"
                    },
                    {
                      "input": "low",
                      "output": "#FBBF24"
                    },
                    {
                      "input": "error",
                      "output": "#FF4646"
                    }
                  ],
                  "outputType": "color",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.style.boxShadow": {
            "binding": {
              "config": {
                "path": "view.params.status"
              },
              "transforms": [
                {
                  "fallback": null,
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "normal",
                      "output": "0 0 6px #2dd4bf"
                    },
                    {
                      "input": "low",
                      "output": "0 0 6px #fbbf24"
                    },
                    {
                      "input": "error",
                      "output": "0 0 8px #f87171"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderRadius": "100%",
            "height": "8px",
            "position": "absolute",
            "right": "16px",
            "top": "10 px",
            "width": "8px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Detail_0"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.detail"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "PerfectBinder/Detail"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "flex-start",
      "direction": "column",
      "style": {
        "classes": "Production_detail/Card",
        "position": "relative"
      }
    },
    "type": "ia.container.flex"
  }
}