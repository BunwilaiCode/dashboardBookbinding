{
  "custom": {},
  "params": {
    "headNo": 1,
    "sheetCount": "256",
    "status": "normal"
  },
  "propConfig": {
    "params.headNo": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sheetCount": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.status": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 100,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "light"
        },
        "position": {
          "basis": "15px"
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.status"
              },
              "transforms": [
                {
                  "fallback": "#000000",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "normal",
                      "output": "#2DD4BF"
                    },
                    {
                      "input": "low",
                      "output": "#FBBF24"
                    },
                    {
                      "input": "error",
                      "output": "#FF4646"
                    }
                  ],
                  "outputType": "color",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.style.boxShadow": {
            "binding": {
              "config": {
                "path": "view.params.status"
              },
              "transforms": [
                {
                  "fallback": null,
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "normal",
                      "output": "0 0 6px #2dd4bf"
                    },
                    {
                      "input": "low",
                      "output": "0 0 6px #fbbf24"
                    },
                    {
                      "input": "error",
                      "output": "0 0 8px #f87171"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderRadius": "100%",
            "height": "8px",
            "width": "8px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "No"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Head \"+{view.params.headNo}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "KPI/Title"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Sheet"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.sheetCount"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "KPI/Unit"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px"
        },
        "props": {
          "style": {
            "classes": "KPI/Unit"
          },
          "text": "sheets"
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "direction": "column",
      "justify": "space-evenly",
      "style": {
        "classes": "Production_detail/Card"
      }
    },
    "type": "ia.container.flex"
  }
}