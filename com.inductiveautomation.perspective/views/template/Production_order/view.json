{
  "custom": {},
  "params": {
    "detail": "Brochure",
    "title": "Book type"
  },
  "propConfig": {
    "params.detail": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 100,
      "width": 152
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.title} + \" :\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Production_detail/Title"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Detail"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.detail"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Production_detail/Detail"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Production_detail/Card"
      }
    },
    "type": "ia.container.flex"
  }
}